{
  "name": "forumnavi",
  "version": "0.4.1",
  "private": true,
  "description": "Filterbares Programm für Fachveranstaltungen mit vielen parallelen Foren",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "pruefen": "node tools/validate.mjs data/events",
    "demo-daten": "node tools/generate_demo.mjs",
    "push-pruefung": "node tools/push_check.mjs --oeffentlich",
    "bauen": "node tools/build.mjs",
    "vorschau": "node tools/build.mjs && npx --yes http-server dist -p 8080 -c-1",
    "vergleich": "node tools/diff.mjs",
    "bericht": "node tools/import_bericht.mjs",
    "freigeben": "node tools/freigeben.mjs",
    "vorschau-intern": "node tools/build.mjs --events ../forumnavi-intern/data/events --ziel ../forumnavi-intern/vorschau && npx --yes http-server ../forumnavi-intern/vorschau -p 8080 -c-1",
    "anlegen": "node tools/anlegen.mjs",
    "ids": "node tools/ids_uebernehmen.mjs",
    "sponsoren": "node tools/sponsoren_uebernehmen.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "axe-core": "4.14.0"
  }
}
