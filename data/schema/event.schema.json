{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forumnavi.de/schema/event.schema.json",
  "title": "Forumnavi Veranstaltung",
  "description": "Programm einer Fachveranstaltung mit parallelen Foren. Zeiten sind Ortszeit der Veranstaltung (siehe event.timezone) im Format JJJJ-MM-TTTHH:MM.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "event", "days", "rooms", "topics", "organizers", "speakers", "forums", "sessions", "sponsors", "sponsorSlots"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },

    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "timezone", "startDate", "endDate", "location", "programStatus", "isDemo"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "shortName": { "$ref": "#/$defs/text" },
        "description": { "type": "string" },
        "timezone": { "type": "string", "enum": ["Europe/Berlin", "Europe/Vienna", "Europe/Zurich"] },
        "startDate": { "$ref": "#/$defs/date" },
        "endDate": { "$ref": "#/$defs/date" },
        "website": { "$ref": "#/$defs/url" },
        "isDemo": { "type": "boolean", "description": "true = erfundene Beispieldaten. Die App zeigt dann einen Hinweis." },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["venue", "city"],
          "properties": {
            "venue": { "$ref": "#/$defs/text" },
            "street": { "type": "string" },
            "postalCode": { "type": "string" },
            "city": { "$ref": "#/$defs/text" },
            "country": { "type": "string", "default": "DE" }
          }
        },
        "programStatus": {
          "type": "object",
          "additionalProperties": false,
          "required": ["date", "version"],
          "description": "Wird beim Freigeben automatisch gesetzt.",
          "properties": {
            "date": { "type": "string", "format": "date-time", "description": "Zeitpunkt der Freigabe (ISO 8601 mit Zeitzone)" },
            "version": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}$", "description": "Versionskennung JJJJ-MM-TT_NN" },
            "source": { "type": "string", "description": "Woher die Daten stammen (z. B. PDF-Dateiname, URL)" },
            "note": { "type": "string" }
          }
        }
      }
    },

    "days": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "date", "label"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "date": { "$ref": "#/$defs/date" },
          "label": { "$ref": "#/$defs/text", "description": "z. B. 'Dienstag, 9. November'" }
        }
      }
    },

    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "$ref": "#/$defs/text" },
          "floor": { "type": "string" },
          "building": { "type": "string" }
        }
      }
    },

    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "$ref": "#/$defs/text" }
        }
      }
    },

    "organizers": {
      "description": "Forenveranstalter",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "$ref": "#/$defs/text" },
          "type": { "type": "string", "enum": ["Verband", "Unternehmen", "Behörde", "Forschung", "Kanzlei", "Veranstalter", "Sonstige"] },
          "website": { "$ref": "#/$defs/url" }
        }
      }
    },

    "speakers": {
      "description": "Referentinnen, Referenten und Moderation",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "$ref": "#/$defs/text" },
          "academicTitle": { "type": "string", "description": "z. B. 'Dr.' oder 'Prof. Dr.'" },
          "position": { "type": "string" },
          "affiliation": { "type": "string", "description": "Firma oder Institution" }
        }
      }
    },

    "forums": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "number", "title", "dayId", "organizerIds"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "number": { "type": "string", "description": "Anzeigenummer, z. B. '12' oder 'P1'" },
          "title": { "$ref": "#/$defs/text" },
          "description": { "type": "string" },
          "kind": { "type": "string", "enum": ["forum", "plenum", "workshop", "rahmenprogramm"], "default": "forum" },
          "dayId": { "$ref": "#/$defs/id" },
          "roomId": { "$ref": "#/$defs/id" },
          "organizerIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
          "moderatorIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
          "topicIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
        }
      }
    },

    "sessions": {
      "description": "Programmpunkte",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "forumId", "title", "start", "end"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "forumId": { "$ref": "#/$defs/id" },
          "title": { "$ref": "#/$defs/text" },
          "description": { "type": "string" },
          "type": { "type": "string", "enum": ["Vortrag", "Diskussion", "Keynote", "Begrüßung", "Workshop", "Pause", "Sonstiges"], "default": "Vortrag" },
          "start": { "$ref": "#/$defs/localDateTime" },
          "end": { "$ref": "#/$defs/localDateTime" },
          "roomId": { "$ref": "#/$defs/id", "description": "Nur angeben, wenn abweichend vom Raum des Forums" },
          "topicIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
          "speakerIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
          "status": { "type": "string", "enum": ["geplant", "geändert", "entfällt"], "default": "geplant" },
          "statusNote": { "type": "string", "description": "z. B. 'Raum geändert' oder 'Referent ersetzt'" }
        }
      }
    },

    "sponsors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "$ref": "#/$defs/text" },
          "logo": { "type": "string", "pattern": "^[a-z0-9_./-]+\\.(svg|png|webp)$", "description": "Pfad relativ zum Veranstaltungsordner, z. B. 'sponsoren/firma.svg'. Keine externen URLs (keine Tracking-Pixel)." },
          "url": { "$ref": "#/$defs/url" }
        }
      }
    },

    "sponsorSlots": {
      "description": "Sponsorflächen. Gehören dem Veranstalter. Werden immer als 'Anzeige' gekennzeichnet.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "placement", "sponsorId"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "placement": { "type": "string", "enum": ["forum_presented_by", "home_banner", "day_banner", "calendar_note"] },
          "sponsorId": { "$ref": "#/$defs/id" },
          "forumId": { "$ref": "#/$defs/id", "description": "Pflicht bei placement = forum_presented_by" },
          "dayId": { "$ref": "#/$defs/id", "description": "Pflicht bei placement = day_banner" },
          "text": { "type": "string", "maxLength": 140 },
          "active": { "type": "boolean", "default": true }
        },
        "allOf": [
          { "if": { "properties": { "placement": { "const": "forum_presented_by" } } }, "then": { "required": ["forumId"] } },
          { "if": { "properties": { "placement": { "const": "day_banner" } } }, "then": { "required": ["dayId"] } }
        ]
      }
    }
  },

  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$", "description": "Kleinbuchstaben, Ziffern, Bindestrich" },
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "localDateTime": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-2][0-9]:[0-5][0-9]$" },
    "url": { "type": "string", "pattern": "^https://" }
  }
}
